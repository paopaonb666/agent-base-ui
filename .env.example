# agent-base-ui configuration
# Copy to .env and adjust. NEVER commit the real .env file.

# Agent-base server URL this UI talks to (SSE /v1/agents/{module}/invoke).
# Can be overridden in the UI setup form / ?apiUrl= URL param.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default agent module to chat with (chat / writer / supervisor, must be
# enabled in agent-base AGENT_MODULES). Overridable in the UI / ?module=.
NEXT_PUBLIC_AGENT_MODULE=chat